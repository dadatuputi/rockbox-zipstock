#! rockbox/tagbrowser/2.0
# ^ Version header must be the first line of every file
#
# ZipStock database menus: Audiobooks first, by author, then series, then
# book 1 to N; then the usual music menus without the books.
#
# A file counts as an audiobook when it sits in a folder named AUDIOBOOKS
# (on either the player or the card) or ends in .m4b. Run tag-books.py on
# the card first: it puts the series in the grouping tag, the book's number
# in the series in the disc number, and a short title in the album tag.
#
# This file replaces Rockbox's own tagnavi.config. Delete it to go back.

# All Books: one line per book. A book in several files gets a line for each
# part: "Book", "Book, part 2" and so on. It lists files rather than albums,
# because Rockbox puts [By album], [All tracks] and [Random] at the top of
# every album list.
%format "fmt_book"        "%s" basename ? album == "<Untagged>"
%format "fmt_book"        "%s, part %d" album tracknum ? tracknum > "1"
%format "fmt_book"        "%s" album

# A book in its series: "5. Order of the Phoenix", in series order. A book
# in several files shows its second file as "5.2 Order of the Phoenix".
%format "fmt_inseries"    "%d.%d %s" discnum tracknum album ? discnum > "0" tracknum > "1"
%format "fmt_inseries"    "%d. %s" discnum album ? discnum > "0"
%format "fmt_inseries"    "%s, part %d" album tracknum ? tracknum > "1"
%format "fmt_inseries"    "%s" basename ? album == "<Untagged>"
%format "fmt_inseries"    "%s" album

# The song list, and the formats the menus below borrow from Rockbox's own file.
%format "fmt_title"       "%s - %02d:%02d (%s)" basename Lm Ls filename ? title == "[Untagged]"
%format "fmt_title"       "%d.%02d. %s - %02d:%02d" discnum tracknum title Lm Ls ? discnum > "0"
%format "fmt_title"       "%02d. %s - %02d:%02d" tracknum title Lm Ls ? tracknum > "0"
%format "fmt_title"       "%s - %02d:%02d" title Lm Ls
%format "fmt_song"        "%s" title
%format "fmt_mostplayed"  "%2d|%3d %s (%s)" playcount autoscore title canonicalartist %sort = "inverse" %limit = "100"
%format "fmt_lastplayed"  "%06d%s - %s" lastplayed canonicalartist title %sort = "inverse" %limit = "99" %strip = "6"

# Music search, as in Rockbox's own menu
%menu_start "search" "Search"
"Artist" -> canonicalartist ? canonicalartist ~ "" -> album -> title = "fmt_title"
"Album" -> album ? album ~ "" -> title = "fmt_title"
"Title" -> title = "fmt_title" ? title ~ ""
"Filename" -> filename ? filename ~ ""

# Audiobooks
%menu_start "books" "Audiobooks"
"Authors" -> canonicalartist ? filename ~ "/AUDIOBOOKS/" | filename $ ".m4b" -> grouping -> title = "fmt_inseries"
"Series" -> grouping ? filename ~ "/AUDIOBOOKS/" | filename $ ".m4b" -> title = "fmt_inseries"
"All Books" -> title = "fmt_book" ? filename ~ "/AUDIOBOOKS/" | filename $ ".m4b"

# Less used music menus
%menu_start "more" "More"
"Album Artists" -> albumartist ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b" -> album -> title = "fmt_title"
"Composers" -> composer ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b" -> album -> title = "fmt_title"
"Years" -> year ? year > "0" & filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b" -> canonicalartist -> album -> title = "fmt_title"
"Recently Added" -> album ? entryage < "4" & commitid > "0" -> title = "fmt_title"
"Most Played" -> title = "fmt_mostplayed" ? playcount > "0"
"Recently Played" -> title = "fmt_lastplayed" ? playcount > "0"
"Search" ==> "search"

# The main database menu
%menu_start "main" "Library"
"Audiobooks" ==> "books"
"Shuffle Songs" ~> title = "fmt_title" ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b"
"Artists" -> canonicalartist ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b" -> album -> title = "fmt_title"
"Albums" -> album ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b" -> title = "fmt_title"
"Songs" -> title = "fmt_song" ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b"
"Genres" -> genre ? filename !~ "/AUDIOBOOKS/" & filename !$ ".m4b" -> canonicalartist -> album -> title = "fmt_title"
"More" ==> "more"

%root_menu "main"
